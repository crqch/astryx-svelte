{
	"name": "docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"generate": "bun scripts/generate-content.mjs && bun scripts/build-astryx-theme.mjs",
		"emit-core-docs": "bun scripts/emit-core-docs.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun scripts/emit-core-docs.mjs --check && bun scripts/check-preview-theme.mjs",
		"lint": "oxfmt --check . && oxlint .",
		"format": "oxfmt --write ."
	},
	"dependencies": {
		"@astryx-svelte/core": "workspace:*",
		"@astryx-svelte/theme-butter": "workspace:*",
		"@astryx-svelte/theme-chocolate": "workspace:*",
		"@astryx-svelte/theme-gothic": "workspace:*",
		"@astryx-svelte/theme-liquid-glass": "workspace:*",
		"@astryx-svelte/theme-matcha": "workspace:*",
		"@astryx-svelte/theme-neutral": "workspace:*",
		"@astryx-svelte/theme-stone": "workspace:*",
		"@astryx-svelte/theme-y2k": "workspace:*",
		"@stylexjs/stylex": "^0.19.0"
	},
	"devDependencies": {
		"@astryxdesign/cli": "0.5.2",
		"@astryxdesign/core": "0.5.2",
		"@qwik.dev/partytown": "^0.14.0",
		"@stylexjs/unplugin": "^0.19.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"playwright": "^1.61.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}

{
	"name": "@astryx-sv/cli",
	"displayName": "CLI",
	"version": "0.7.13",
	"description": "Scaffold projects, browse templates, generate themes, and get agent-ready docs from the command line.",
	"homepage": "https://github.com/crqch/astryx-svelte#readme",
	"bugs": {
		"url": "https://github.com/crqch/astryx-svelte/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crqch/astryx-svelte.git",
		"directory": "packages/cli"
	},
	"bin": {
		"astryx-svelte": "./bin/astryx-svelte.mjs"
	},
	"files": [
		"bin",
		"api",
		"assets",
		"authoring",
		"clients",
		"foundation",
		"!**/*.test.mjs"
	],
	"type": "module",
	"exports": {
		".": "./bin/astryx-svelte.mjs",
		"./json": {
			"types": "./api/json/index.ts",
			"import": "./api/json/parse.mjs"
		},
		"./api": {
			"import": "./api/index.mjs"
		},
		"./authoring": {
			"types": "./authoring/index.d.ts",
			"import": "./authoring/index.mjs"
		},
		"./config": {
			"types": "./authoring/config/type.ts",
			"import": "./authoring/config/parse.mjs"
		},
		"./integration": {
			"types": "./authoring/integration/type.ts",
			"import": "./authoring/integration/parse.mjs"
		},
		"./doc": {
			"types": "./authoring/doctypes/types.ts",
			"import": "./authoring/doctypes/parse.mjs"
		},
		"./template": {
			"types": "./authoring/doctypes/types.ts",
			"import": "./authoring/doctypes/template/parse.mjs"
		},
		"./codemod": {
			"types": "./authoring/codemod/type.ts",
			"import": "./authoring/codemod/parse.mjs"
		},
		"./xle": {
			"types": "./foundation/xle/browser.d.ts",
			"import": "./foundation/xle/browser.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"astryx-svelte": "bun bin/astryx-svelte.mjs",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "oxfmt --check . && oxlint .",
		"format": "oxfmt --write .",
		"test:unit": "vitest",
		"test:core-src": "bun scripts/assert-core-ships-src.mjs",
		"generate-themes": "bun scripts/generate-cli-themes.mjs",
		"test:themes-bundle": "bun scripts/generate-cli-themes.mjs --check",
		"test": "vitest --run && bun run test:core-src && bun run test:themes-bundle"
	},
	"dependencies": {
		"commander": "^14.0.0",
		"jiti": "^2.7.0",
		"magic-string": "^0.30.21",
		"zimmerframe": "^1.1.4",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@astryx-sv/core": "workspace:*",
		"@astryx-sv/theme-neutral": "workspace:*",
		"@fvilers/heroicons-svelte": "2.1.5-fix.3",
		"@lucide/svelte": "^1.25.0",
		"@types/node": "^22",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@astryx-sv/core": "*",
		"@astryx-sv/theme-neutral": "*",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@astryx-sv/core": {
			"optional": true
		},
		"@astryx-sv/theme-neutral": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	}
}

{
	"name": "@astryx-svelte/theme-butter",
	"version": "0.5.2",
	"description": "Butter theme for astryx-svelte — warm, creamy yellows with a friendly blue accent.",
	"homepage": "https://github.com/devrohit06/astryx-svelte#readme",
	"bugs": {
		"url": "https://github.com/devrohit06/astryx-svelte/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/devrohit06/astryx-svelte.git",
		"directory": "packages/themes/butter"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./tokens": {
			"types": "./dist/tokens.d.ts",
			"svelte": "./dist/tokens.js",
			"import": "./dist/tokens.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun scripts/build-theme.mjs",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "oxfmt --check .",
		"format": "oxfmt --write .",
		"test:parity": "bun scripts/compare-upstream.mjs",
		"test:icons": "bun scripts/check-icons.mjs",
		"test": "bun run build && bun run test:parity && bun run test:icons"
	},
	"dependencies": {
		"@lucide/svelte": "^1.25.0"
	},
	"devDependencies": {
		"@astryx-svelte/core": "workspace:*",
		"@astryxdesign/theme-butter": "0.5.2",
		"svelte": "^5.56.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@astryx-svelte/core": "workspace:^",
		"svelte": "^5.0.0"
	}
}

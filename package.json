{
	"name": "astryx-svelte",
	"version": "0.0.0",
	"private": true,
	"description": "A Svelte 5 port of Astryx, Meta's open source design system. Unofficial and not affiliated with Meta.",
	"license": "MIT",
	"workspaces": [
		"packages/*",
		"packages/themes/*",
		"docs"
	],
	"type": "module",
	"scripts": {
		"dev": "bun run --filter docs dev",
		"build": "bun run --filter '*' build",
		"check": "bun run --filter '*' check",
		"test": "bun run --filter '*' test",
		"lint": "bun run --filter '*' lint",
		"lint:root": "oxfmt --check port/*.md *.md && oxlint scripts .github .claude/hooks",
		"format": "bun run --filter '*' format",
		"check:publish": "bun scripts/check-publish.mjs",
		"deploy:docs": "bun run --filter 'docs...' build && bun run --filter docs deploy",
		"status": "bun scripts/status.mjs",
		"status:full": "bun scripts/status.mjs --full",
		"verify": "bun scripts/verify.mjs",
		"verify:fast": "bun scripts/verify.mjs --fast"
	},
	"devDependencies": {
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"packageManager": "bun@1.3.14"
}
